+#include <cstring>
+static bool moe_trace_cb(struct ggml_tensor * t, bool ask, void *) {
+    static FILE * f = fopen(getenv("LLAMA_MOE_TRACE"), "ab");
+    if (strncmp(t->name, "ffn_moe_probs-", 14) != 0) { return !ask; }
+    if (ask) { return true; }
+    static std::vector<float> buf;
+    GGML_ASSERT(t->type == GGML_TYPE_F32);
+    const size_t n = ggml_nbytes(t);
+    buf.resize(n / sizeof(float));
+    ggml_backend_tensor_get(t, buf.data(), 0, n);
+    const int32_t hdr[3] = { atoi(t->name + 14), (int32_t) t->ne[0], (int32_t) t->ne[1] };
+    fwrite(hdr, sizeof(int32_t), 3, f);
+    fwrite(buf.data(), sizeof(float), buf.size(), f);
+    fflush(f);
+    return true;
+}
