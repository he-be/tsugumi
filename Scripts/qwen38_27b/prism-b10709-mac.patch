+    static const bool pq2_0_ext_enable = getenv("GGML_METAL_PQ2_0_EXT_ENABLE") != nullptr;
+    static const int  pq2_0_mv_max     = getenv("GGML_METAL_PQ2_0_MV_MAX") ? atoi(getenv("GGML_METAL_PQ2_0_MV_MAX")) : 8;
+
+    const bool is_pq2 = op->src[0]->type == GGML_TYPE_PQ2_0 || op->src[0]->type == GGML_TYPE_PTQ1_0;
+
+    const int ne11_mm_min = op->src[0]->type == GGML_TYPE_Q1_0 ? std::max(8, q1_0_mv_max) :
+                            is_pq2                             ? std::max(8, pq2_0_mv_max) : 8;
 
     if (ggml_metal_op_mul_mat_q1_0_pc_supported(op)) {
         const int32_t nblk = ne00/128;
@@ -2799,8 +2808,8 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
            op->src[0]->type == GGML_TYPE_BF16 ||
            (op->src[0]->type == GGML_TYPE_Q1_0 && q1_0_ext_enable) ||
            op->src[0]->type == GGML_TYPE_Q2_0 ||
-           op->src[0]->type == GGML_TYPE_PQ2_0 ||
-           op->src[0]->type == GGML_TYPE_PTQ1_0 ||
+           (op->src[0]->type == GGML_TYPE_PQ2_0  && pq2_0_ext_enable) ||
+           (op->src[0]->type == GGML_TYPE_PTQ1_0 && pq2_0_ext_enable) ||
            op->src[0]->type == GGML_TYPE_Q4_0 ||
            op->src[0]->type == GGML_TYPE_Q4_1 ||
            op->src[0]->type == GGML_TYPE_Q5_0 ||
diff --git a/src/models/qwen35.cpp b/src/models/qwen35.cpp
index c5f816e..b73021d 100644
--- a/src/models/qwen35.cpp
+++ b/src/models/qwen35.cpp
@@ -634,6 +634,18 @@ llama_model_qwen35::graph_mtp::graph_mtp(const llama_model & model, const llm_gr
         ggml_tensor * tok_embd_w = layer.nextn.embed_tokens ? layer.nextn.embed_tokens : model.tok_embd;
 
         tok_embd = ggml_get_rows(ctx0, tok_embd_w, inp->tokens);
+
+        // a Hadamard-latent embedding table stores rotated rows; restore the
+        // primal basis right after the lookup, as build_inp_embd() does
+        if (hadamard_inverses) {
+            const auto it = hadamard_inverses->find(tok_embd_w);
+            if (it != hadamard_inverses->end()) {
+                tok_embd = llama_mul_mat_hadamard(ctx0, tok_embd, it->second.rot);
+                if (it->second.signs) {
+                    tok_embd = ggml_mul(ctx0, tok_embd, it->second.signs);
+                }
+            }
+        }
     } else {
         tok_embd = inp->embd;
     }
