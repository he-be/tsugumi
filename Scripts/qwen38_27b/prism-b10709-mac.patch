+// PQ2_0 multi-column mat-vec: each PQ2_0 block is read once and dotted against nr1
+// src1 columns (the spec-decode verify batch, ne11 = k+1). Same 8 threads per block
+// and 16 weights per thread as the single-column kernel above, so the staged y grows
+// to nr1*16 floats; the four base-4 fields of a weight byte are also peeled once and
+// reused across the columns, which halves the floor chain as well as the weight read.
+template<int nr0, int nr1, typename args_t>
+void kernel_mul_mv_pq2_0_f32_nc_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    const int nb = args.ne00/QK_PQ2_0;
+
+    const int r0 = tgpig.x;
+    const int r1 = tgpig.y;
+    const int im = tgpig.z;
+
+    const int first_row = (r0 * NSG + sgitg) * nr0;
+    const int c0        = r1 * nr1;
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    device const block_pq2_0 * ax[nr0];
+    for (int row = 0; row < nr0; ++row) {
+        const uint64_t offset0 = (first_row + row)*args.nb01 + (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+        ax[row] = (device const block_pq2_0 *) ((device char *) src0 + offset0);
+    }
+
+    float yl[nr1][16];
+    float sumy[nr1];
+    float sumf[nr0][nr1];
+    FOR_UNROLL (short row = 0; row < nr0; row++) {
+        FOR_UNROLL (short c = 0; c < nr1; c++) {
+            sumf[row][c] = 0.f;
+        }
+    }
+
+    // group 128: 8 sub-blocks of 16 weights per PQ2_0 block
+    const short ix = (tiisg/8);
+    const short il = (tiisg%8)*16;
+
+    device const float * yb[nr1];
+    FOR_UNROLL (short c = 0; c < nr1; c++) {
+        // tail columns are clamped (computed but not stored)
+        const int ic = min(c0 + c, args.ne11 - 1);
+        const uint64_t offset1 = (uint64_t)ic*args.nb11 + (i12)*args.nb12 + (i13)*args.nb13;
+        yb[c] = (device const float *) (src1 + offset1) + ix*QK_PQ2_0 + il;
+    }
+
+    for (int ib = ix; ib < nb; ib += N_SIMDWIDTH/8) {
+        FOR_UNROLL (short c = 0; c < nr1; c++) {
+            float s = 0.f;
+
+            FOR_UNROLL (short j = 0; j < 4; j++) {
+                const float y0 = yb[c][4*j + 0];
+                const float y1 = yb[c][4*j + 1];
+                const float y2 = yb[c][4*j + 2];
+                const float y3 = yb[c][4*j + 3];
+                s += (y0 + y1) + (y2 + y3);
+                yl[c][4*j + 0] = y3 - 4.0f*y2;
+                yl[c][4*j + 1] = y2 - 4.0f*y1;
+                yl[c][4*j + 2] = y1 - 4.0f*y0;
+                yl[c][4*j + 3] = y0;
+            }
+
+            sumy[c] = s;
+        }
+
+        FOR_UNROLL (short row = 0; row < nr0; row++) {
+            device const block_pq2_0 * qb = ax[row] + ib;
+            device const uint8_t     * qs = qb->qs + (il / 4);
+
+            float w[16];
+            FOR_UNROLL (short j = 0; j < 4; j++) {
+                const float b = (float) qs[j];
+                const float u = b * (1.0f/256.0f);
+                w[4*j + 0] = floor( 4.0f*u);
+                w[4*j + 1] = floor(16.0f*u);
+                w[4*j + 2] = floor(64.0f*u);
+                w[4*j + 3] = b;
+            }
+
+            const float d = qb->d;
+
+            FOR_UNROLL (short c = 0; c < nr1; c++) {
+                float acc = 0.f;
+                FOR_UNROLL (short i = 0; i < 16; i++) {
+                    acc += w[i]*yl[c][i];
+                }
+                sumf[row][c] += d*(acc - sumy[c]);
+            }
+        }
+
+        FOR_UNROLL (short c = 0; c < nr1; c++) {
+            yb[c] += QK_PQ2_0 * (N_SIMDWIDTH/8);
+        }
+    }
+
+    device float * dst_f32 = (device float *) dst + (uint64_t)im*args.ne0*args.ne1;
+
+    for (short c = 0; c < nr1; c++) {
+        if (c0 + c >= args.ne11) {
+            break;
+        }
+        for (int row = 0; row < nr0; ++row) {
+            const float tot = simd_sum(sumf[row][c]);
+
+            if (tiisg == 0 && first_row + row < args.ne01) {
+                dst_f32[(uint64_t)(c0 + c)*args.ne0 + first_row + row] = tot;
+            }
+        }
+    }
+}
